# ============================================================
# WOW AI Voice Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB_NAME=wowai

# --- AI Provider Configuration ---
AI_PRIMARY_PROVIDER=gemini
AI_SECONDARY_PROVIDER=grok
AI_LOCAL_FALLBACK=ollama
AI_DEMO_FALLBACK=true

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_COOLDOWN_SECONDS=300

# --- Grok / xAI ---
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_COOLDOWN_SECONDS=300

# --- Ollama (Local Fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Voice Provider ---
VOICE_PROVIDER=vapi
VOICE_API_KEY=
VOICE_DEMO_MODE=true

# --- Frontend ---
VITE_API_URL=http://localhost:5000
VITE_DEMO_MODE=true
